<?xml version="1.0" encoding="utf-8"?>
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:mp="microsoft.com"
    xmlns:uap="microsoft.com"
    xmlns:rescap="microsoft.com">
    <Identity
        Name="AndrewPowell.MakiDice"
        Publisher="CN=EA508F5B-94C6-49C1-9E55-2FAF44A9213C"
        Version="1.9.2.0"
        ProcessorArchitecture="x64"/>
    <Properties>
        <DisplayName>Maki Dice</DisplayName>
        <PublisherDisplayName>Andrew Powell</PublisherDisplayName>
        <Logo>Images\StoreLogo.png</Logo>
    </Properties>
    <Dependencies>
        <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22000.0" />
    </Dependencies>
    <Resources>
        <Resource Language="x-generate"/>
    </Resources>
    <Applications>
        <Application Id="App" Executable="MakiDice.exe" EntryPoint="Windows.FullTrustApplication">
            <uap:VisualElements
                DisplayName="Maki Dice"
                Description="Dice for role-playing games"
                BackgroundColor="transparent"
                Square150x150Logo="Images\Square150x150Logo.png"
                Square44x44Logo="Images\Square44x44Logo.png">
            <uap:DefaultTile 
                Wide310x150Logo="Images\Wide310x150Logo.png"/>
            </uap:VisualElements>
        </Application>
    </Applications>
    <Capabilities>
        <rescap:Capability Name="runFullTrust" />
    </Capabilities>
</Package>