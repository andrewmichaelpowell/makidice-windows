<UserControl x:Class="MakiDice.Views.D10View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16,0,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button x:Name="BackButton"
                Grid.Row="0"
                Click="Back_Click"
                Width="36" Height="36"
                HorizontalAlignment="Left"
                Margin="0,16,0,0"
                Cursor="Hand"
                FocusVisualStyle="{x:Null}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border CornerRadius="18" Background="{DynamicResource SecondaryBackgroundBrush}" />
                        <Border x:Name="PressOverlay" CornerRadius="18" Background="Black" Opacity="0" />
                        <Path Data="M 9.52,1.68 L 3.92,7 L 9.52,12.32"
                              Stroke="{DynamicResource LabelBrush}"
                              StrokeThickness="2.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Width="14" Height="14"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressOverlay" Property="Opacity" Value="0.18" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <StackPanel Grid.Row="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0" StretchDirection="DownOnly" HorizontalAlignment="Left">
                    <TextBlock x:Name="DiceLabel" Text="Dice" FontSize="34" Foreground="{DynamicResource LabelBrush}" />
                </Viewbox>
                <TextBlock x:Name="DiceValueText" Grid.Column="1" Text="" FontSize="34"
                           Foreground="{DynamicResource LabelBrush}" TextAlignment="Right"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0" StretchDirection="DownOnly" HorizontalAlignment="Left">
                    <TextBlock x:Name="DifficultyLabel" Text="Difficulty" FontSize="34" Foreground="{DynamicResource LabelBrush}" />
                </Viewbox>
                <TextBlock x:Name="DifficultyValueText" Grid.Column="1" Text="" FontSize="34"
                           Foreground="{DynamicResource LabelBrush}" TextAlignment="Right"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0" StretchDirection="DownOnly" HorizontalAlignment="Left">
                    <TextBlock Text="Successes" FontSize="34" Foreground="{DynamicResource LabelBrush}" />
                </Viewbox>
                <TextBlock x:Name="SuccessesValueText" Grid.Column="1" Text="" FontSize="34"
                           Foreground="{DynamicResource LabelBrush}" TextAlignment="Right"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </StackPanel>

        <UniformGrid Grid.Row="3" Columns="2" Margin="0,16,0,0">
            <Button x:Name="SelectDiceButton" Click="SelectDice_Click" Margin="4"
                    Style="{StaticResource DiceButtonStyle}" Content="Dice" />
            <Button x:Name="SelectDifficultyButton" Click="SelectDifficulty_Click" Margin="4"
                    Style="{StaticResource DiceButtonStyle}" Content="Difficulty" />
        </UniformGrid>

        <StackPanel Grid.Row="4" Margin="0,32,0,32">
            <UniformGrid Columns="3">
                <Button Tag="1" Click="Pool_Click" Margin="4" Style="{StaticResource DiceButtonStyle}"
                        Background="{DynamicResource SecondaryBackgroundBrush}" Foreground="{DynamicResource LabelBrush}"
                        Content="1" />
                <Button Tag="2" Click="Pool_Click" Margin="4" Style="{StaticResource DiceButtonStyle}"
                        Background="{DynamicResource SecondaryBackgroundBrush}" Foreground="{DynamicResource LabelBrush}"
                        Content="2" />
                <Button Tag="3" Click="Pool_Click" Margin="4" Style="{StaticResource DiceButtonStyle}"
                        Background="{DynamicResource SecondaryBackgroundBrush}" Foreground="{DynamicResource LabelBrush}"
                        Content="3" />
            </UniformGrid>
            <UniformGrid Columns="3">
                <Button Tag="4" Click="Pool_Click" Margin="4" Style="{StaticResource DiceButtonStyle}"
                        Background="{DynamicResource SecondaryBackgroundBrush}" Foreground="{DynamicResource LabelBrush}"
                        Content="4" />
                <Button Tag="5" Click="Pool_Click" Margin="4" Style="{StaticResource DiceButtonStyle}"
                        Background="{DynamicResource SecondaryBackgroundBrush}" Foreground="{DynamicResource LabelBrush}"
                        Content="5" />
                <Button Tag="6" Click="Pool_Click" Margin="4" Style="{StaticResource DiceButtonStyle}"
                        Background="{DynamicResource SecondaryBackgroundBrush}" Foreground="{DynamicResource LabelBrush}"
                        Content="6" />
            </UniformGrid>
            <UniformGrid Columns="3">
                <Button Tag="7" Click="Pool_Click" Margin="4" Style="{StaticResource DiceButtonStyle}"
                        Background="{DynamicResource SecondaryBackgroundBrush}" Foreground="{DynamicResource LabelBrush}"
                        Content="7" />
                <Button Tag="8" Click="Pool_Click" Margin="4" Style="{StaticResource DiceButtonStyle}"
                        Background="{DynamicResource SecondaryBackgroundBrush}" Foreground="{DynamicResource LabelBrush}"
                        Content="8" />
                <Button Tag="9" Click="Pool_Click" Margin="4" Style="{StaticResource DiceButtonStyle}"
                        Background="{DynamicResource SecondaryBackgroundBrush}" Foreground="{DynamicResource LabelBrush}"
                        Content="9" />
            </UniformGrid>
            <UniformGrid Columns="3">
                <Button Click="Clear_Click" Margin="4" Style="{StaticResource DiceButtonStyle}"
                        Background="{StaticResource OrangeBrush}" Foreground="White"
                        Content="Clear" />
                <Button Tag="10" Click="Pool_Click" Margin="4" Style="{StaticResource DiceButtonStyle}"
                        Background="{DynamicResource SecondaryBackgroundBrush}" Foreground="{DynamicResource LabelBrush}"
                        Content="10" />
                <Button Click="Roll_Click" Margin="4" Style="{StaticResource DiceButtonStyle}"
                        Background="{StaticResource OrangeBrush}" Foreground="White"
                        Content="Roll" />
            </UniformGrid>
        </StackPanel>
    </Grid>
</UserControl>
